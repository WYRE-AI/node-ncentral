{
  "name": "@wyre-technology/node-ncentral",
  "version": "1.0.0",
  "description": "Node.js/TypeScript client library for the N-able N-central REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "n-central",
    "ncentral",
    "n-able",
    "api",
    "sdk",
    "rmm",
    "msp"
  ],
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyre-technology/node-ncentral.git"
  },
  "bugs": {
    "url": "https://github.com/wyre-technology/node-ncentral/issues"
  },
  "homepage": "https://github.com/wyre-technology/node-ncentral#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@types/node": "^25.9.3",
    "msw": "^2.7.0",
    "semantic-release": "^25.0.5",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
